# Only the files that identify the checked-out commit; the build records it
# so run receipts carry BESTDECKS_COMMIT_SHA without a manual step.
.git/*
!.git/HEAD
!.git/packed-refs
!.git/refs
.github
.next
.data
.agents
.claude
.codex
.firecrawl
.pnpm-store
.vercel
app_data
dist
node_modules
output
tmp
tsconfig.tsbuildinfo
*.log
.env*
!.env.example
!.env.production.example
.DS_Store
