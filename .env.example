NODE_ENV=development
# Repository policy; local Next.js CLI invocations also force this before Next loads.
NEXT_TELEMETRY_DISABLED=1
# Optional source commit retained in run receipts. Production deployments should set it.
BESTDECKS_COMMIT_SHA=

# --- Providers -------------------------------------------------------------
# The free path needs one key: GEMINI_API_KEY (free tier at
# https://aistudio.google.com/apikey). It drives research summaries, briefs,
# and slide plans. Crawling and first-party research need no key.
GEMINI_API_KEY=
# builtin: plain HTTPS crawl that respects robots.txt (free, no key).
# cloudflare: Cloudflare Browser Rendering (renders JavaScript; needs the two
# CLOUDFLARE_* values). Unset means cloudflare if those are present, else builtin.
CRAWL_PROVIDER=builtin
# site: research from the target's own pages and feed, summarized by Gemini (free).
# perplexity: external web research (paid; needs PERPLEXITY_API_KEY).
# Unset means perplexity if a key is present, else site.
RESEARCH_PROVIDER=site
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
PERPLEXITY_API_KEY=
# Experimental adapter outside the reference path.
DEEPCRAWL_API_KEY=

# --- Renderer (self-hosted Presenton, no key) -------------------------------
PRESENTON_BASE_URL=http://localhost:5050
# Local renderer image must be an immutable name@sha256:<digest> reference.
PRESENTON_IMAGE=
PRESENTON_CONTAINER_NAME=bestdecks-presenton-local
PRESENTON_NETWORK_NAME=bestdecks-presenton-render-only
PRESENTON_PORT=5050
# Self-hosted Presenton uses HTTP Basic authentication.
PRESENTON_AUTH_USERNAME=
PRESENTON_AUTH_PASSWORD=
# Hosted api.presenton.ai uses its bearer API key instead of Basic auth.
PRESENTON_API_KEY=
PRESENTON_TEMPLATE=bestdecks_inline_vector_v1
# Set to 1 only when a self-hosted renderer intentionally uses a private network address.
ALLOW_PRIVATE_PROVIDER_URLS=0
ALLOW_USER_PROVIDER_ENDPOINTS=0
# Single-user installs: 1 lets signed-in users run with the keys in this file.
# Multi-user hosting: 0, and each user saves their own keys in the console.
ALLOW_SHARED_PROVIDER_CREDENTIALS=1
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000
# Required for every app process. Do not reuse APP_SECRETS_KEY.
# Generate an independent value with at least 32 bytes of entropy.
BETTER_AUTH_SECRET=
# Optional one-time local bootstrap. Leave disabled after the account exists.
SEED_ADMIN_ON_STARTUP=0
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Independent key for encrypting stored provider credentials.
APP_SECRETS_KEY=
# Temporary fallback used only during a documented key rotation. Remove it after rewrap verification.
APP_SECRETS_KEY_PREVIOUS=
LOCAL_DB_PATH=
