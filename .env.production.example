NODE_ENV=production
# Repository policy; build and runtime images must not emit Next.js CLI telemetry.
NEXT_TELEMETRY_DISABLED=1
BESTDECKS_COMMIT_SHA=
# These are separate trust domains. Generate an independent random value for each.
APP_SECRETS_KEY=
# Temporary fallback used only during a documented key rotation.
APP_SECRETS_KEY_PREVIOUS=
BETTER_AUTH_SECRET=
# These must identify the same public TLS origin served by APP_DOMAIN below.
BETTER_AUTH_URL=https://example.com
NEXT_PUBLIC_BETTER_AUTH_URL=https://example.com
RENDER_EXTERNAL_URL=
SEED_ADMIN_ON_STARTUP=0
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
LOCAL_DB_PATH=.data/custom-proposals.sqlite

# Every production base image must be supplied as an immutable digest reference.
NODE_IMAGE=
CADDY_IMAGE=
PRESENTON_IMAGE=

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
DEEPCRAWL_API_KEY=
PERPLEXITY_API_KEY=
GEMINI_API_KEY=

# The self-hosted renderer is reachable only on Compose's internal backend.
PRESENTON_BASE_URL=http://presenton
PRESENTON_AUTH_USERNAME=
PRESENTON_AUTH_PASSWORD=
# Hosted api.presenton.ai only; leave empty for the self-hosted Compose service.
PRESENTON_API_KEY=
PRESENTON_TEMPLATE=bestdecks_inline_vector_v1
ALLOW_PRIVATE_PROVIDER_URLS=1
ALLOW_USER_PROVIDER_ENDPOINTS=0
# This example is the documented single-tenant Compose topology. Use 0 instead
# for multi-user hosting and configure complete tenant-owned integration records.
ALLOW_SHARED_PROVIDER_CREDENTIALS=1

APP_DOMAIN=example.com
