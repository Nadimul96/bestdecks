{
  "name": "bestdecks",
  "version": "0.2.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "scripts": {
    "dev": "node --require ./scripts/disable-next-telemetry.cjs ./node_modules/next/dist/bin/next dev",
    "build": "node --require ./scripts/disable-next-telemetry.cjs ./node_modules/next/dist/bin/next build --webpack",
    "lint": "eslint . --max-warnings=0",
    "start": "node --require ./scripts/disable-next-telemetry.cjs ./node_modules/next/dist/bin/next start",
    "worker": "node --import tsx src/bin/run-worker.ts",
    "worker:once": "node --import tsx src/bin/run-worker.ts --once",
    "check": "pnpm typecheck && pnpm validate:example && pnpm plan:example",
    "test:unit": "node --import tsx --test src/**/*.test.ts",
    "uat:smoke": "tsx scripts/uat-smoke.ts",
    "doctor": "node --import tsx src/bin/doctor.ts",
    "smoke:crawl": "node --import tsx src/bin/smoke-builtin-crawl.ts",
    "smoke:research": "node --import tsx src/bin/smoke-site-research.ts",
    "smoke:cloudflare": "node --import tsx src/bin/smoke-cloudflare.ts",
    "smoke:gemini": "node --import tsx src/bin/smoke-gemini.ts",
    "smoke:perplexity": "node --import tsx src/bin/smoke-perplexity.ts",
    "smoke:presenton": "node --import tsx src/bin/smoke-presenton.ts",
    "smoke:plusai": "node --import tsx src/bin/smoke-plusai.ts",
    "smoke:plusai-planned": "node --import tsx src/bin/smoke-plusai-planned.ts",
    "smoke:providers:reference": "pnpm doctor && pnpm smoke:crawl && pnpm smoke:research && pnpm smoke:gemini && pnpm smoke:presenton",
    "secrets:rewrap": "node --import tsx src/bin/rewrap-integration-secrets.ts",
    "setup": "node scripts/setup-local.mjs",
    "presenton:start": "node scripts/presenton-start.mjs",
    "plan:example": "node --import tsx src/bin/plan-example.ts",
    "typecheck": "tsc --noEmit",
    "validate:example": "node --import tsx src/bin/validate-example.ts",
    "verify:standalone": "node scripts/check-standalone-boundary.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@libsql/client": "0.17.4",
    "@libsql/kysely-libsql": "^0.4.1",
    "better-auth": "1.7.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dotenv": "^18.0.7",
    "kysely": "0.29.6",
    "lucide-react": "^1.55.0",
    "next": "16.4.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "10.12.0",
    "eslint-config-next": "16.4.0",
    "playwright": "^1.64.0",
    "postcss": "8.5.29",
    "tailwindcss": "^4.3.3",
    "tsx": "4.23.15",
    "typescript": "~6.0.3"
  }
}
